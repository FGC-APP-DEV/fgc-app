# Server-only values. Copy to .env.local in fgc-app; never commit it.
NODE_ENV=development
PORT=4000
WEB_ORIGINS=http://localhost:3000
# Reverse proxies in front of the API (0-5); drives req.ip for rate limits. Unset = none.
# TRUST_PROXY_HOPS=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Generate three independent 32-byte keys and encode each as base64.
AUTH_ENCRYPTION_KEY=
AUTH_CSRF_KEY=
AUTH_RATE_LIMIT_KEY=
MENTOR_HMAC_SECRET=
WORKER_SECRET=
# Exact configured URLs; do not use production values until provisioned.
AUTH_WEB_CALLBACK_URL=
AUTH_WEB_EXCHANGE_URL=
AUTH_MOBILE_CALLBACK_URL=
AUTH_MOBILE_EXCHANGE_URL=
# Mobile public configuration goes in apps/fgc-mobile/.env.local.
# EXPO_PUBLIC_API_BASE_URL=https://your-api-domain/api/v1
# FGC_APP_SCHEME=
# FGC_APP_LINK_DOMAIN=
# FGC_EAS_PROJECT_ID=
# FGC_IOS_BUNDLE_IDENTIFIER=
# FGC_ANDROID_PACKAGE=
