{
  "name": "notifications",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/notifications/src",
  "projectType": "library",
  "tags": [
    "platform:client",
    "type:domain",
    "scope:notifications"
  ],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "libs/notifications/**/*.{ts,tsx}"
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "jest.config.js",
        "passWithNoTests": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p libs/notifications/tsconfig.check.json"
      }
    },
    "typecheck-native": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p libs/notifications/tsconfig.native.json"
      }
    }
  }
}
