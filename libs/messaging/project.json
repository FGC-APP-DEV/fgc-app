{
  "name": "messaging",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/messaging/src",
  "projectType": "library",
  "tags": [
    "scope:messaging",
    "platform:client",
    "type:domain"
  ],
  "// targets": "to see all targets run: nx show project messaging --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p libs/messaging/tsconfig.check.json"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "jest.config.js",
        "passWithNoTests": false,
        "runInBand": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "libs/messaging/**/*.{ts,tsx}"
        ]
      }
    }
  }
}
