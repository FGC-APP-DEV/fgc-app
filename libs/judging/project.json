{
  "name": "judging",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/judging/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:feature"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/judging",
        "main": "libs/judging/src/index.ts",
        "tsConfig": "libs/judging/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["libs/judging/**/*.{ts,tsx}"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "jest.config.js",
        "passWithNoTests": true
      }
    }
  }
}
