{
  "name": "judging",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/judging/src",
  "projectType": "library",
  "tags": [
    "scope:shared",
    "type:feature"
  ],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "libs/judging/**/*.{ts,tsx}"
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "jest.config.js",
        "passWithNoTests": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p libs/judging/tsconfig.check.json"
      }
    }
  }
}
