{
  "name": "admin",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/admin/src",
  "projectType": "library",
  "tags": ["scope:admin", "platform:client", "type:domain"],
  "// targets": "to see all targets run: nx show project admin --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p libs/admin/tsconfig.check.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["libs/admin/**/*.{ts,tsx}"]
      }
    }
  }
}
