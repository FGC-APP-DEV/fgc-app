{
  "name": "server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/server/src",
  "projectType": "library",
  "tags": [
    "platform:server",
    "type:domain",
    "scope:server"
  ],
  "// targets": "to see all targets run: nx show project server --web",
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "jest.config.js",
        "passWithNoTests": false,
        "runInBand": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p libs/server/tsconfig.check.json"
      }
    }
  }
}
