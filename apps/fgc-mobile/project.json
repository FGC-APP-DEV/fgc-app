{
  "name": "fgc-mobile",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/fgc-mobile/src",
  "projectType": "application",
  "tags": [
    "scope:fgc-mobile",
    "platform:client",
    "type:app"
  ],
  "targets": {
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm exec -- expo start",
        "cwd": "apps/fgc-mobile"
      }
    },
    "start-go": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm exec -- expo start --go",
        "cwd": "apps/fgc-mobile"
      }
    },
    "start-dev-client": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm exec -- expo start --dev-client",
        "cwd": "apps/fgc-mobile"
      }
    },
    "export": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "npm exec -- expo export --output-dir dist",
        "cwd": "apps/fgc-mobile"
      }
    },
    "run-ios": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm exec -- expo run:ios",
        "cwd": "apps/fgc-mobile"
      }
    },
    "run-android": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm exec -- expo run:android",
        "cwd": "apps/fgc-mobile"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/fgc-mobile/**/*.{ts,tsx}"
        ]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/fgc-mobile/tsconfig.json"
      }
    }
  }
}
