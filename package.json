{
  "name": "@fgc/monorepo",
  "version": "1.0.0",
  "description": "FGC operations: Nx, REST/Supabase, React Native Web and Expo",
  "private": true,
  "scripts": {
    "dev:api": "nx serve fgc-api",
    "dev:web": "nx serve fgc-web",
    "dev:mobile": "nx run fgc-mobile:start",
    "build": "nx run-many -t build -p fgc-web,fgc-api",
    "build:api": "nx build fgc-api",
    "build:web": "nx build fgc-web",
    "test": "nx run-many -t test -p contracts,api-client,auth,server,judging,messaging,notifications,ui",
    "lint": "nx run-many --target=lint --all",
    "graph": "nx graph",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "clean": "node -e \"const fs=require('fs');const p='node_modules';if(fs.existsSync(p)){fs.rmSync(p,{recursive:true,force:true,maxRetries:5,retryDelay:300})}\"",
    "reinstall": "npm run clean && npm install",
    "typecheck": "nx run-many -t typecheck",
    "test:e2e": "nx run fgc-web:e2e",
    "test:sql": "nx run database:test-sql"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.116.0",
    "cors": "^2.8.5",
    "exceljs": "4.4.0",
    "expo": "57.0.24",
    "expo-constants": "57.0.19",
    "expo-crypto": "57.0.3",
    "expo-dev-client": "57.0.19",
    "expo-device": "57.0.2",
    "expo-document-picker": "57.0.2",
    "expo-file-system": "57.0.7",
    "expo-font": "57.0.4",
    "expo-linking": "57.0.10",
    "expo-notifications": "57.0.20",
    "expo-secure-store": "57.0.4",
    "express": "^4.21.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@babel/core": "^7.23.6",
    "@babel/preset-env": "^7.23.6",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@nx/eslint": "22.7.12",
    "@nx/eslint-plugin": "22.7.12",
    "@nx/jest": "22.7.12",
    "@nx/js": "22.7.12",
    "@nx/web": "22.7.12",
    "@nx/webpack": "22.7.12",
    "@nx/workspace": "22.7.12",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.5",
    "@types/react": "~19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "babel-jest": "^29.7.0",
    "css-loader": "^6.8.1",
    "dotenv": "^16.3.1",
    "esbuild": "0.25.12",
    "eslint": "^8.56.0",
    "eslint-plugin-security": "^3.0.1",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "nx": "22.7.12",
    "prettier": "^3.1.1",
    "style-loader": "^3.3.3",
    "supertest": "^7.2.2",
    "ts-loader": "^9.5.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "5.2.6",
    "webpack-subresource-integrity": "^5.1.0",
    "zod-to-json-schema": "3.25.2",
    "@electric-sql/pglite": "0.5.8"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "optionalDependencies": {
    "@nx/nx-win32-x64-msvc": "22.7.12"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "license": "MIT"
}
