{
  "name": "@fgc/monorepo",
  "version": "1.0.0",
  "description": "FGC Coordination & Judging — Nx monorepo (web, API, mobile, GraphQL, Drizzle)",
  "private": true,
  "scripts": {
    "dev:api": "nx serve fgc-api",
    "dev:web": "nx serve fgc-web",
    "dev:mobile": "nx run fgc-mobile:start",
    "dev:local": "npm run docker:up && npx wait-on tcp:localhost:5432 -t 60000 && npm run db:migrate && npx concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "build": "nx run-many --target=build --all",
    "build:api": "nx build fgc-api",
    "build:web": "nx build fgc-web",
    "test": "nx run-many --target=test --all",
    "lint": "nx run-many --target=lint --all",
    "graph": "nx graph",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "db:generate": "cd libs/database && npx drizzle-kit generate",
    "db:migrate": "cd libs/database && npx drizzle-kit migrate",
    "db:push": "cd libs/database && npx drizzle-kit push",
    "db:seed": "cd libs/database && npx tsx src/seed/index.ts",
    "db:studio": "cd libs/database && npx drizzle-kit studio",
    "clean": "node -e \"const fs=require('fs');const p='node_modules';if(fs.existsSync(p)){fs.rmSync(p,{recursive:true,force:true,maxRetries:5,retryDelay:300})}\"",
    "reinstall": "npm run clean && npm install"
  },
  "dependencies": {
    "@apollo/client": "^4.1.2",
    "@apollo/server": "^5.5.0",
    "@as-integrations/express4": "^1.1.2",
    "@react-native-async-storage/async-storage": "^1.21.0",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.0",
    "graphql": "^16.12.0",
    "graphql-tag": "^2.12.6",
    "i18next": "^25.8.18",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.12.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-i18next": "^16.5.8",
    "react-native": "^0.85.2",
    "react-native-web": "^0.19.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@babel/core": "^7.23.6",
    "@babel/preset-env": "^7.23.6",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@graphql-codegen/cli": "^7.0.0",
    "@graphql-codegen/typescript": "^6.0.0",
    "@graphql-codegen/typescript-operations": "^6.0.0",
    "@graphql-codegen/typescript-react-apollo": "^4.0.0",
    "@nx/eslint": "^22.7.1",
    "@nx/jest": "^22.7.1",
    "@nx/js": "22.6.0",
    "@nx/node": "^22.7.1",
    "@nx/react": "^22.7.1",
    "@nx/react-native": "^22.7.1",
    "@nx/web": "^22.7.1",
    "@nx/webpack": "^22.7.1",
    "@nx/workspace": "22.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "babel-jest": "^29.7.0",
    "concurrently": "^9.1.0",
    "css-loader": "^6.8.1",
    "dotenv": "^16.3.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.56.0",
    "eslint-plugin-security": "^3.0.1",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^29.7.0",
    "nx": "22.6.0",
    "prettier": "^3.1.1",
    "style-loader": "^3.3.3",
    "ts-loader": "^9.5.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "wait-on": "^8.0.1",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^1.16.5",
    "webpack-subresource-integrity": "^5.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "optionalDependencies": {
    "@nx/nx-win32-x64-msvc": "22.6.0"
  },
  "overrides": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "license": "MIT"
}
