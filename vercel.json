{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist/apps/fgc-web",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://SUBSTITUA-PELO-HOST-DO-RENDER.onrender.com/api/:path*" },
    { "source": "/health/:path*", "destination": "https://SUBSTITUA-PELO-HOST-DO-RENDER.onrender.com/health/:path*" },
    { "source": "/((?!api/|health/).*)", "destination": "/index.html" }
  ]
}
